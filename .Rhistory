geom_smooth(method = 'lm') +
geom_smooth(se = FALSE, method = 'loess') +
labs(title = 'FLUT Stock vs Google Hits', x = 'Google Hits', y = 'FLUT Stock Price')
# Tennis
flut_hits %>%
ggplot(aes(x = tennis, y = FLUT.Close)) +
geom_point() +
geom_smooth(method = 'lm') +
geom_smooth(se = FALSE, color = 'red', method = 'loess') +
labs(title = 'FLUT Stock vs Tennis Search Hits', x = 'Tennis Search Hits', y = 'FLUT Stock Price')
# Horse Racing
flut_hits %>%
ggplot(aes(x = `horse racing`, y = FLUT.Close)) +
geom_point() +
geom_smooth(method = 'lm') +
geom_smooth(se = FALSE, color = 'red', method = 'loess') +
labs(title = 'FLUT Stock vs Horse Racing Search Hits', x = 'Horse Racing Search Hits', y = 'FLUT Stock Price')
