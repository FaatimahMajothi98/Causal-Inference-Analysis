# Import Libraries
library(cobalt)
library(WeightIt)
library(lmtest)
library(sandwich)
library(tidyverse)
library(dplyr)
# Save current warn option to restore later
old_warn_option <- getOption('warn')
# Suppress all warnings
options(warn = -1)
# Import data
caus_df <- read.csv('caus_df.csv')
head(caus_df)
# Create treatment and control group column
threshold <- mean(caus_df$gaming_hrs) * 0.25
caus_df$above_25pct_avg <- as.integer(caus_df$gaming_hrs > threshold)
# Rename X variable for clarity
caus_df %>% rename(weekly_gaming_hrs = gaming_hrs)
# Check percentage
print(mean(caus_df$above_25pct_avg) * 100)
head(caus_df)
# Plot balance plots
bal.plot(x = above_25pct_avg ~ screen_time_total, data = caus_df, var.name = 'screen_time_total')
bal.plot(x = above_25pct_avg ~ income, data = caus_df, var.name = 'income')
bal.plot(x = above_25pct_avg ~ addiction_level, data = caus_df, var.name = 'addiction_level')
bal.plot(x = above_25pct_avg ~ age, data = caus_df, var.name = 'age')
bal.tab(
above_25pct_average ~ age + income + daily_gaming_hours +
years_gaming + sleep_hours + caffeine_intake + exercise_hours +
stress_level + anxiety_score + depression_score +
social_interaction_score + academic_performance +
work_productivity + addiction_level +
multiplayer_ratio + toxic_exposure + violent_games_ratio +
night_gaming_ratio + weekend_gaming_hours +
friends_gaming_count + online_friends + streaming_hours +
microtransactions_spending + screen_time_total + eye_strain_score +
back_pain_score + weekly_gaming_hrs + z_stress +
z_anxiety + z_depression + z_loneliness + z_aggression +
z_happiness + m_health,
data = caus_df,
binary = "std",
disp.v.ratio = TRUE
)
bal.tab(
above_25pct_avg ~ age + income + daily_gaming_hours +
years_gaming + sleep_hours + caffeine_intake + exercise_hours +
stress_level + anxiety_score + depression_score +
social_interaction_score + academic_performance +
work_productivity + addiction_level +
multiplayer_ratio + toxic_exposure + violent_games_ratio +
night_gaming_ratio + weekend_gaming_hours +
friends_gaming_count + online_friends + streaming_hours +
microtransactions_spending + screen_time_total + eye_strain_score +
back_pain_score + weekly_gaming_hrs + z_stress +
z_anxiety + z_depression + z_loneliness + z_aggression +
z_happiness + m_health,
data = caus_df,
binary = "std",
disp.v.ratio = TRUE
)
